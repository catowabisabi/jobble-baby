{
  "expo": {
    "name": "Jobble Baby",
    "slug": "jobble-baby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleId": "com.jobblebaby.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Jobble Baby needs camera access for photo features",
        "NSPhotoLibraryUsageDescription": "Jobble Baby needs photo library access to save baby photos"
      }
      // App Store screenshots: add 5.5" and 6.7" display screenshots via Expo orbit
      // "screenshotUrls": ["https://..."]
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jobblebaby.app",
      "splash": {
        "backgroundColor": "#E6F4FE",
        "resizeMode": "contain"
      }
      // Google Play Store listing:
      // "localizedTitle": "Jobble Baby",
      // "localizedDescription": "Your baby product guide...",
      // "localizedShortDescription": "Baby product info at your fingertips",
      // "video": "https://play.google.com/video/..."
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
