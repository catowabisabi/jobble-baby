{
  "expo": {
    "name": "Jobble Baby",
    "slug": "jobble-baby",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleId": "com.jobblebaby.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Jobble Baby needs camera access for photo features",
        "NSPhotoLibraryUsageDescription": "Jobble Baby needs photo library access to save baby photos"
      },
      "bundleIdentifier": "com.jobblebaby.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jobblebaby.app",
      "splash": {
        "backgroundColor": "#E6F4FE",
        "resizeMode": "contain"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "jobblebaby"
  }
}
