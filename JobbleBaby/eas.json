{
  "cli": {
    "version": ">= 13.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "SENTRY_DSN"
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "SENTRY_DSN"
      }
    },
    "production": {
      "ios": {
        "bundleIdentifier": "com.jobblebaby.app"
      },
      "android": {
        "package": "com.jobblebaby.app",
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_SENTRY_DSN": "SENTRY_DSN"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "bundleIdentifier": "com.jobblebaby.app"
      },
      "android": {
        "package": "com.jobblebaby.app"
      }
    }
  }
}
