# Fastfile for Jobble Baby
# https://docs.fastlane.tools/advanced/Fastfile/
#
# Usage:
#   fastlane ios beta          # Upload to TestFlight
#   fastlane ios release       # Upload to App Store
#   fastlane ios screenshots   # Generate screenshots
#
# Setup:
#   1. Fill in Appfile with your Apple ID and team ID
#   2. Run: fastlane spaceauth  (to authenticate with Apple)
#   3. Run: fastlane ios beta

# Required: minimum fastlane version
min_fastlane_version("2.220.0")

# Optional: silence output
ENV["FASTLANE_HIDE_CHANGELOG"] = "1"

platform :ios do
  desc "Build and upload to TestFlight (internal testing)"
  lane :beta do
    # Ensure certificates are up to date
    match(ntype: "appstore", readonly: is_ci)

    # Build the app using xcodebuild
    build_app(
      workspace: "JobbleBaby.xcworkspace",
      scheme: "JobbleBaby",
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      distribute_external: false,
      groups: ["Internal Testers"]
    )

    puts "Build uploaded to TestFlight!"
  end

  desc "Build and upload to App Store (production)"
  lane :release do
    # Ensure certificates are up to date
    match(ntype: "appstore", readonly: is_ci)

    # Build the app
    build_app(
      workspace: "JobbleBaby.xcworkspace",
      scheme: "JobbleBaby",
      configuration: "Release",
      export_method: "app-store"
    )

    # Upload to App Store
    upload_to_app_store(
      skip_metadata: false,
      skip_screenshots: true,  # Set to false if you have screenshots
      skip_binary_upload: false,
      reject_if_missing: true
    )

    puts "Build submitted to App Store!"
  end

  desc "Generate App Store screenshots"
  lane :screenshots do
    capture_screenshots(workspace: "JobbleBaby.xcworkspace", scheme: "JobbleBaby")
    frame_screenshots
    upload_to_app_store(skip: :metadata, skip_screenshots: false)
  end
end

# Helper: Detect if running in CI
def is_ci
  ENV['CI'] == 'true'
end